<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start">

    <!-- Avatar (for receiver only) -->
    <ImageView
        android:id="@+id/avatarImage"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:layout_gravity="bottom"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        android:background="@drawable/bg_circle"/>

    <!-- Bubble Container -->
    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Text Message -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello message"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:visibility="visible"/>

        <!-- Image Message -->
        <ImageView
            android:id="@+id/imageMessage"
            android:layout_width="240dp"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="@drawable/bg_image_message"/>

        <!-- Audio Message -->
        <androidx.cardview.widget.CardView
            android:id="@+id/audioContainer"
            android:layout_width="200dp"
            android:layout_height="48dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/audioPlayButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_play"
                    app:tint="#FFFFFF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="#4DFFFFFF"/>

                <TextView
                    android:id="@+id/audioDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:14"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Time -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:08"
            android:textSize="10sp"
            android:textColor="#80FFFFFF"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</LinearLayout>






